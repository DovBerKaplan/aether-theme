#!/usr/bin/env bash
# Keep Kvantum, the Aurorae titlebar, Konsole and the GTK/browser apps in step with the active KDE color scheme.
# Triggered by aether-mode-sync.path whenever ~/.config/kdeglobals changes.
set -euo pipefail
# A look-and-feel apply leaks its package defaults (ColorScheme=...) into kdedefaults; there the
# entry shadows the live scheme and makes plasma-apply-colorscheme believe the theme is already
# active, so nothing is written and no app is notified. The live kdeglobals always carries the
# explicit name after a real apply - keep the defaults layer clean so re-applies always land.
sed -i '/^ColorScheme=/d' "$HOME/.config/kdedefaults/kdeglobals" 2>/dev/null || true
# A switch writes kdeglobals several times over a second or two (the island's colour apply, the
# look-and-feel apply, its keys): a sync that reads half-way follows the mode being left, and writes
# that land while it runs do not start it again - the icons, titlebar and Kvantum stayed one tap
# behind. So wait for the file to rest first, and at the end run again if the mode moved meanwhile.
globals="$HOME/.config/kdeglobals"
for _ in $(seq 16); do
  before="$(stat -c %y "$globals" 2>/dev/null || true)"; sleep 0.5
  [[ "$(stat -c %y "$globals" 2>/dev/null || true)" == "$before" ]] && break
done
judge() {
  local s r g b _
  s="$(kreadconfig6 --file kdeglobals --group General --key ColorScheme)"
  # The name is not always written (a LnF apply can leave it out): then judge by the window colour,
  # as the island does, and only if the look-and-feel is one of ours.
  if [[ -z $s ]] && [[ "$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage)" == org.aether.* ]]; then
    IFS=, read -r r g b _ <<< "$(kreadconfig6 --file kdeglobals --group Colors:Window --key BackgroundNormal)"   # r,g,b or r,g,b,a
    (( (${r:-0} + ${g:-0} + ${b:-0}) / 3 < 128 )) && s=AetherGlass || s=AetherSerenity
  fi
  echo "$s"
}
scheme="$(judge)"
case "$scheme" in
  AetherGlass) kv=AetherGlass ;;
  AetherSerenity) kv=AetherSerenity ;;
  *) exit 0 ;;  # not one of ours: leave the user's choice alone
esac
# ...and put the name back. With no ColorScheme anywhere (the LnF apply leaves it out, and the
# kdedefaults copy is cleared above), KDE's idea of the current scheme falls back to BreezeLight -
# and `plasma-apply-colorscheme --accent-color`, which the island runs on every start and accent
# change, recolours the *current* scheme whatever name it is given: the desktop turned Breeze Light
# a moment after a Dark tap. Written in place, as widgetStyle below, and verified.
if ! grep -q "^ColorScheme=$scheme\$" "$HOME/.config/kdeglobals" 2>/dev/null; then
  for i in 1 2 3; do
    python3 - "$HOME/.config/kdeglobals" "$scheme" <<'PYEOF'
import sys
p, name = sys.argv[1], sys.argv[2]
lines = [l for l in open(p).readlines() if not l.startswith("ColorScheme=")]
for i, l in enumerate(lines):
    if l.strip() == "[General]":
        lines.insert(i + 1, "ColorScheme=%s\n" % name)
        break
else:
    lines.insert(0, "[General]\nColorScheme=%s\n\n" % name)
open(p, "w").writelines(lines)
PYEOF
    sleep 1
    grep -q "^ColorScheme=$scheme\$" "$HOME/.config/kdeglobals" 2>/dev/null && { echo "scheme name -> $scheme"; break; }
  done
fi
# GTK, libadwaita, Firefox, Chromium and Electron do not read KDE colors: they follow the freedesktop
# color-scheme (gsettings) and the GTK settings. Move them together with the KDE scheme. Breeze-GTK
# draws from the colors.css KDE writes from the active scheme, so GTK apps wear our palette and the
# island's accent too.
if [[ $scheme == AetherGlass ]]; then
  prefer=prefer-dark gtkdark=true gtktheme=Breeze-Dark
else
  prefer=prefer-light gtkdark=false gtktheme=Breeze
fi
if command -v gsettings >/dev/null; then
  [[ "$(gsettings get org.gnome.desktop.interface color-scheme)" == "'$prefer'" ]] || { gsettings set org.gnome.desktop.interface color-scheme "$prefer"; echo "gsettings color-scheme -> $prefer"; }
fi
# KDE's GTK module owns the GTK theme (settings.ini, gsettings, xsettingsd): ask it, else write it by hand.
if [[ "$(qdbus6 org.kde.GtkConfig /GtkConfig org.kde.GtkConfig.gtkTheme 2>/dev/null)" != "$gtktheme" ]]; then
  qdbus6 org.kde.GtkConfig /GtkConfig org.kde.GtkConfig.setGtkTheme "$gtktheme" >/dev/null 2>&1 \
    || { command -v gsettings >/dev/null && gsettings set org.gnome.desktop.interface gtk-theme "$gtktheme"; }
  echo "gtk -> $gtktheme"
fi
for v in 3.0 4.0; do
  ini="$HOME/.config/gtk-$v/settings.ini"
  [[ -f $ini ]] || continue
  sed -i -e "s/^gtk-application-prefer-dark-theme=.*/gtk-application-prefer-dark-theme=$gtkdark/" -e "s/^gtk-theme-name=.*/gtk-theme-name=$gtktheme/" "$ini"
done
current="$(kreadconfig6 --file "$HOME/.config/Kvantum/kvantum.kvconfig" --group General --key theme)"
if [[ "$current" != "$kv" ]]; then
  kwriteconfig6 --file "$HOME/.config/Kvantum/kvantum.kvconfig" --group General --key theme "$kv"
  echo "kvantum -> $kv"
fi
# The Flatpak sandboxes mount kdeglobals but never kdedefaults: without the style key in the live
# file their Qt apps fall back to Breeze, and Breeze blends the scheme's translucent glass over an
# opaque white base - Dolphin and Konsole turn milky, half stuck in light mode. The key in
# kdedefaults reaches only native apps; re-assert the live one every time the file is rewritten.
if ! grep -q '^widgetStyle=kvantum$' "$HOME/.config/kdeglobals" 2>/dev/null; then
  # kreadconfig6 would lie here: it falls back to kdedefaults, where the key always exists.
  # kwriteconfig6's QSaveFile rename keeps losing this file to a stale KConfig clobber (the
  # write exits 0, the mtime moves, the key vanishes): write in place, and verify it stuck.
  for i in 1 2 3; do
    python3 - "$HOME/.config/kdeglobals" <<'PYEOF'
import sys
p = sys.argv[1]
lines = open(p).readlines()
if not any(l.rstrip("\n") == "widgetStyle=kvantum" for l in lines):
    for i, l in enumerate(lines):
        if l.strip() == "[KDE]":
            lines.insert(i + 1, "widgetStyle=kvantum\n")
            break
    else:
        lines.append("\n[KDE]\nwidgetStyle=kvantum\n")
    open(p, "w").writelines(lines)
PYEOF
    sleep 1
    grep -q '^widgetStyle=kvantum$' "$HOME/.config/kdeglobals" 2>/dev/null && { echo "widgetStyle -> kvantum (sandboxed apps)"; break; }
  done
fi
# The titlebar (Aurorae) follows too: a LnF apply sets it, a colour-only switch (by hours) does not.
deco="__aurorae__svg__$scheme"
if [[ -d "$HOME/.local/share/aurorae/themes/$scheme" ]] && [[ "$(kreadconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme)" != "$deco" ]]; then
  kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key library org.kde.kwin.aurorae
  kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme "$deco"
  qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
  echo "titlebar -> $scheme"
fi
# The icons follow as well, for the same reason: the island's switch into Auto (by hours) changes
# only the colours, so coming from a hand-picked Light at night left Colloid-Light's dark glyphs on
# the dark glass. Only a Colloid variant is moved - an icon theme picked elsewhere stays.
# plasma-changeicons writes the theme and tells every running app to repaint its icons.
icons="$(kreadconfig6 --file kdeglobals --group Icons --key Theme)"
[[ $scheme == AetherGlass ]] && want=Colloid-Dark || want=Colloid-Light
changeicons=/usr/lib/x86_64-linux-gnu/libexec/plasma-changeicons
[[ -x $changeicons ]] || changeicons="$(command -v plasma-changeicons || true)"
if [[ $icons == Colloid-Dark || $icons == Colloid-Light ]] && [[ $icons != "$want" ]] && [[ -n $changeicons ]]; then
  "$changeicons" "$want" >/dev/null 2>&1 && echo "icons -> $want"
fi
# Every aether wallpaper carries a dark and a light field: switch it on every desktop that wears one.
# A stuck Mode here poisons every glass window at once (the translucency takes its tone from the
# wallpaper), and the old write-if-different could fail silently: the config object can serve a
# stale Mode, and `|| true` swallowed a dead plasmashell. Write unconditionally and verify it stuck.
[[ $scheme == AetherGlass ]] && mode=dark || mode=light
wset() { qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "desktops().forEach(function (d) {
  if (d.wallpaperPlugin.indexOf('org.aether.') != 0) return;
  d.currentConfigGroup = ['Wallpaper', d.wallpaperPlugin, 'General'];
  d.writeConfig('Mode', '$mode'); });" >/dev/null 2>&1
  qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "var n = 0; desktops().forEach(function (d) {
  if (d.wallpaperPlugin.indexOf('org.aether.') != 0) return;
  d.currentConfigGroup = ['Wallpaper', d.wallpaperPlugin, 'General'];
  if (d.readConfig('Mode') != '$mode') n++; }); print(n);" 2>/dev/null; }
for i in 1 2; do
  [[ "$(wset)" == 0 ]] && { echo "wallpaper -> $mode"; break; }
  sleep 2
done
profile="$HOME/.local/share/konsole/Aether.profile"
if [[ -f $profile ]] && [[ "$(kreadconfig6 --file "$profile" --group Appearance --key ColorScheme)" != "$scheme" ]]; then
  kwriteconfig6 --file "$profile" --group Appearance --key ColorScheme "$scheme"
  echo "konsole -> $scheme"
fi
# The Flatpak Konsole reads only its own data folder (the host's ~/.local/share is not in its
# sandbox): mirror the profile and the schemes there.
fk="$HOME/.var/app/org.kde.konsole"
if [[ -d $fk && -f $profile ]]; then
  mkdir -p "$fk/data/konsole"
  cp "$profile" "$HOME"/.local/share/konsole/Aether*.colorscheme "$fk/data/konsole/"
  kwriteconfig6 --file "$fk/config/konsolerc" --group "Desktop Entry" --key DefaultProfile Aether.profile
fi
# Aethergram watches its live theme (palette + chat background) and palette and re-applies them: put
# the mode's recoloured copies there (aether-accent-sync keeps both modes beside them), each through a
# temp file and a rename, never half-written.
tg="${AETHER_TG_OUT:-${XDG_DATA_HOME:-$HOME/.local/share}/aethergram/aether.tdesktop-palette}"
tgtheme="${AETHER_TG_THEME_OUT:-$(dirname "$tg")/aether.tdesktop-theme}"
[[ $scheme == AetherGlass ]] && tgmode=dark || tgmode=light
tgswap() {   # live file, its mode's copy
  [[ -f $2 ]] && ! cmp -s "$2" "$1" || return 0
  local tmp; tmp="$(mktemp "$(dirname "$1")/.$(basename "$1").XXXXXX")"
  cp "$2" "$tmp" && mv -f "$tmp" "$1" && echo "aethergram -> $(basename "$2")"
}
tgswap "$tgtheme" "$(dirname "$tgtheme")/aether-$tgmode.tdesktop-theme"
tgswap "$tg" "$(dirname "$tg")/aether-$tgmode.tdesktop-palette"
# The mode moved while this ran (the writes behind it did not start a new run): follow it.
if [[ "$(judge)" != "$scheme" ]] && (( ${AETHER_MODE_SYNC_PASS:-0} < 3 )); then
  AETHER_MODE_SYNC_PASS=$(( ${AETHER_MODE_SYNC_PASS:-0} + 1 )) exec "$0"
fi
