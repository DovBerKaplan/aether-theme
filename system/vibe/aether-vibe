#!/usr/bin/env python3
"""aether-vibe: keep AI agents working with the lid closed and the screen dark.

A vibe session lasts until it is turned off. `on` starts a detached session that
holds logind inhibitors (sleep:idle:handle-lid-switch), so nothing suspends
the machine while the agents run - not the lid switch, not an idle timeout,
not powerdevil. When the lid closes, the screens' DPMS is switched off right
away - but only when the laptop panel is the single live screen, so an
external display you may be using is left alone; Plasma's own idle blanking
is untouched. When the lid opens, the screens light again and the session
keeps running (it used to end there, and the tile switched itself off under
the user). Reacting only to a close *transition* keeps the panel
dark-proof: if the ACPI lid switch stays stuck at "closed" (it does on some
machines, the panel is then the screen you work on), nothing ever blanks. A transition counts only after the new reading
holds through three follow-up samples: a flapping lid switch (this panel's
does - one stray "open" while the lid is shut used to end the session right
after closing) is ignored. Every accepted and ignored transition is appended
to $XDG_RUNTIME_DIR/aether-vibe.log.

The session runs in a systemd scope of its own, so restarting the island (which
starts it) no longer kills it. The island's Vibe tile reads
$XDG_RUNTIME_DIR/aether-vibe.state (the session pid) and follows the session.

Commands:
  on | off | toggle | status
  run    internal: the session body, executed under systemd-inhibit
"""
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

STATE = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "aether-vibe.state"
LOG = STATE.parent / "aether-vibe.log"
WHAT = "sleep:idle:handle-lid-switch"
POLL = 2.0
STABLE = 3                                   # consecutive agreeing samples before a transition counts


def die(msg):
    print(f"aether-vibe: {msg}", file=sys.stderr)
    sys.exit(1)


def session_pid():
    """The pid in the state file, but only if it is really a live aether-vibe session."""
    try:
        pid = int(STATE.read_text().strip())
    except (OSError, ValueError):
        return 0
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().decode("utf-8", "replace")
    except OSError:
        return 0
    return pid if "aether-vibe" in cmdline else 0


def running():
    return session_pid() != 0


def lid_closed():
    r = subprocess.run(["busctl", "get-property", "org.freedesktop.login1", "/org/freedesktop/login1",
                        "org.freedesktop.login1.Manager", "LidClosed"], capture_output=True, text=True)
    return "true" in r.stdout


def log(event):
    try:
        lines = LOG.read_text().splitlines()[-199:] if LOG.exists() else []
        lines.append(f"{time.strftime('%m-%d %H:%M:%S')} {event}")
        LOG.write_text("\n".join(lines) + "\n")
    except OSError:
        pass


def holds(sample):
    """True when `sample` survives STABLE follow-up reads - a flap does not."""
    for _ in range(STABLE):
        if lid_closed() != sample:
            return False
        time.sleep(0.4)
    return True


def panel_alone():
    """True when the laptop panel (eDP/LVDS) is the only screen that is on."""
    r = subprocess.run(["kscreen-doctor", "-o"], capture_output=True, text=True)
    text = re.compile(r"\x1b\[[0-9;]*m").sub("", r.stdout)     # kscreen-doctor colorizes even when piped
    name, enabled, panel = "", 0, False
    for line in text.splitlines():
        parts = line.split()
        if not parts:
            continue
        if parts[0] == "Output:":
            name = parts[2] if len(parts) > 2 else ""
            if "enabled" in parts[3:]:          # compact form: "Output: 1 eDP-1 enabled connected ..."
                enabled += 1
                panel = panel or name.startswith("eDP") or name.startswith("LVDS")
        elif parts[0] == "enabled":             # long form: one property per line
            enabled += 1
            if name.startswith("eDP") or name.startswith("LVDS"):
                panel = True
    return enabled == 1 and panel


def dpms(on):
    subprocess.run(["kscreen-doctor", "--dpms", "on" if on else "off"], capture_output=True)


def run():
    STATE.write_text(str(os.getppid()))        # systemd-inhibit is the session leader `off` will signal
    closed = lid_closed()
    log(f"session start (pid {os.getppid()}, lid {'closed' if closed else 'open'})")
    try:
        while STATE.exists():
            now = lid_closed()
            if now != closed and holds(now):   # a real transition: the new reading held through the re-samples
                closed = now
                if closed:
                    if panel_alone():          # the lid just closed: darken the screens, keep the machine awake
                        log("lid closed -> dpms off")
                        dpms(False)
                else:
                    log("lid open -> dpms on")
                    dpms(True)                 # the lid opened: wake the screens, the session goes on
            elif now != closed:
                log(f"lid flap ignored ({'open' if now else 'closed'} sample while {'closed' if closed else 'open'})")
                now = closed                   # keep tracking the stable state
            closed = now
            time.sleep(POLL)
    finally:
        dpms(True)
        STATE.unlink(missing_ok=True)
        log("session end")


def start():
    if running():
        return
    STATE.unlink(missing_ok=True)              # a stale state file from a killed session
    cmd = ["systemd-inhibit", "--what", WHAT, "--mode", "block", sys.executable, os.path.abspath(__file__), "run"]
    if shutil.which("systemd-run"):            # out of the caller's cgroup: an island restart must not end it
        cmd = ["systemd-run", "--user", "--scope", "--collect", "--quiet", "--unit", f"aether-vibe-{os.getpid()}", "--"] + cmd
    subprocess.Popen(cmd,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    for _ in range(20):                        # the runner owns the state file: wait for it to appear
        if STATE.exists():
            return
        time.sleep(0.1)
    die("the session did not start")


def stop():
    pid = session_pid()
    if pid:
        try:
            os.killpg(pid, signal.SIGTERM)     # systemd-inhibit and the runner share the group
        except ProcessLookupError:
            pass
        for _ in range(20):
            if not running():
                break
            time.sleep(0.1)
    STATE.unlink(missing_ok=True)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "run":
        def term(*_):
            signal.signal(signal.SIGTERM, signal.SIG_IGN)   # one is enough: a second one used to cut the cleanup short (screens left dark)
            sys.exit(0)
        signal.signal(signal.SIGTERM, term)
        run()
    elif cmd == "on":
        start()
    elif cmd == "off":
        stop()
    elif cmd == "toggle":
        stop() if running() else start()
    elif cmd == "status":
        on = running()
        print("on" if on else "off")
        sys.exit(0 if on else 1)
    else:
        die(f"unknown command: {cmd}")


if __name__ == "__main__":
    main()
