#!/usr/bin/env python3
"""Carry the island's accent (its Color panel) into the app themes: the Kvantum theme, the Aurorae
titlebar, Konsole's cursor and the installed colour-scheme files (sandboxed KDE apps - the Flatpak
Dolphin, Konsole, Gwenview - read the scheme file, not the colours baked into kdeglobals). The scheme's own accent (KDE apps, and GTK through
KDE's colors.css) is the island's job: TileStore::applySystemAccent runs plasma-apply-colorscheme
with the scheme's name - never call it here without one, it falls back to BreezeLight.

Triggered by aether-accent-sync.path whenever ~/.config/aetherislandrc changes. That file is only
ever read here. The generated themes (installed under ~/.local/share/aether-apps by
install/install-apps.sh) carry the dark theme's cyan as a placeholder; every run rebuilds the live
copies from them, so it is idempotent and cheap, and writes only what actually changed.

Aethergram (the Telegram Desktop fork) gets its two recoloured palettes beside its live one, and the
live one - aether.tdesktop-palette, which it watches and re-applies - in the current mode's colours.

    AETHER_ISLANDRC=/path/to/copy aether-accent-sync    # try another colour without touching the real file
    AETHER_TG_OUT=/tmp/x/aether.tdesktop-palette ...    # ...and write Aethergram's live palette elsewhere
"""
import colorsys
import configparser
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
ISLANDRC = Path(os.environ.get("AETHER_ISLANDRC", HOME / ".config/aetherislandrc"))
TEMPLATES = HOME / ".local/share/aether-apps"
KVANTUM = HOME / ".config/Kvantum"
AURORAE = HOME / ".local/share/aurorae/themes"
KONSOLE_PROFILE = HOME / ".local/share/konsole/Aether.profile"
SCHEMES = HOME / ".local/share/color-schemes"
DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
TG_LIVE = Path(os.environ.get("AETHER_TG_OUT", DATA / "aethergram/aether.tdesktop-palette"))

# Placeholders in the generated themes (theme/tokens.toml cyan family) -> role of the accent.
PLACEHOLDERS = {"#00f2fe": "accent", "#00dce6": "hover", "#00696f": "deep", "#00373a": "ink"}


def accent() -> tuple[float, float, float] | None:
    """The island's colour as HLS, by the same formula as the island (QColor::fromHslF)."""
    cp = configparser.ConfigParser(interpolation=None)
    try:
        cp.read(ISLANDRC)
    except configparser.Error:
        return None
    a = cp["Appearance"] if cp.has_section("Appearance") else {}
    if str(a.get("AccentSet", "false")).lower() != "true":
        return None
    hue = min(max(int(float(a.get("AccentHue", 183))), 0), 359) / 360
    light = min(max(float(a.get("AccentLight", 0.5)), 0.25), 0.8)
    sat = min(max(float(a.get("AccentSat", 1.0)), 0.15), 1.0)
    return hue, light, sat


def hexof(h: float, l: float, s: float) -> str:
    r, g, b = colorsys.hls_to_rgb(h, min(max(l, 0), 1), min(max(s, 0), 1))
    return "#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))


def roles(hls) -> dict[str, str]:
    h, l, s = hls
    return {"accent": hexof(h, l, s), "hover": hexof(h, l * 0.92, s), "deep": hexof(h, l * 0.45, s),
            "ink": hexof(h, 0.12, s)}


def write_if_changed(path: Path, text: str) -> bool:
    if path.exists() and path.read_text() == text:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    return True


def dec(h: str) -> str:
    return ",".join(str(int(h[i:i + 2], 16)) for i in (1, 3, 5))


def recolor(text: str, colors: dict[str, str] | None) -> str:
    """Placeholders as #rrggbb (SVG, Kvantum) and as r,g,b (KDE .colors files), with or
    without an alpha suffix (translucent selections: BackgroundNormal=r,g,b,a)."""
    if not colors:
        return text
    for ph, role in PLACEHOLDERS.items():
        text = re.sub(re.escape(ph), colors[role], text, flags=re.I)
        text = re.sub(rf"(?<==){re.escape(dec(ph))}(,\d+)?$", dec(colors[role]) + r"\1", text, flags=re.M)
    return text


def luma(h: str) -> float:
    return (0.299 * int(h[1:3], 16) + 0.587 * int(h[3:5], 16) + 0.114 * int(h[5:7], 16)) / 255


def tg_fix(text: str, colors: dict[str, str] | None) -> str:
    """Recolour a Telegram palette; lines marked `// on-accent` / `// on-deep` take the ink that reads
    on that fill (Theme.qml's onAccent: dark ink over a bright fill, white over a dark one), alpha kept."""
    text = recolor(text, colors)
    if not colors:
        return text
    def ink(m):
        fill = colors["accent" if m.group(4) == "accent" else "deep"]
        on = colors["ink"] if luma(fill) > 0.5 else "#ffffff"
        return f"{m.group(1)}{on}{m.group(2) or ''}{m.group(3)}"
    return re.sub(r"^(\w+: )#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?(; // on-(accent|deep))$", ink, text, flags=re.M)


def mode_is_light() -> bool:
    """aether-mode-sync's judge(): the scheme's name, else (under an aether look-and-feel) the window colour."""
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    cp.optionxform = str
    try:
        cp.read(HOME / ".config/kdeglobals")
    except configparser.Error:
        return False
    scheme = cp.get("General", "ColorScheme", fallback="")
    if not scheme and cp.get("KDE", "LookAndFeelPackage", fallback="").startswith("org.aether."):
        rgb = [int(x) for x in cp.get("Colors:Window", "BackgroundNormal", fallback="0,0,0").split(",")[:3] if x.strip().isdigit()]
        return sum(rgb) / max(len(rgb), 1) >= 128
    return scheme == "AetherSerenity"


def replace_atomic(path: Path, text: str) -> bool:
    """Write via a temp file in the same folder and a rename: a watcher never sees half a file."""
    if path.exists() and path.read_text() == text:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(text)
    os.replace(tmp, path)
    return True


def set_key(text: str, key: str, value: str) -> str:
    return re.sub(rf"^{re.escape(key)}=.*$", f"{key}={value}", text, flags=re.M)


def sync_tree(src: Path, dst: Path, fix) -> bool:
    """Mirror src into dst, passing every text file through fix(name, text)."""
    changed = False
    for f in src.rglob("*"):
        if f.is_dir():
            continue
        out = dst / f.relative_to(src)
        if f.suffix in (".svg", ".kvconfig", ".rc", ".colorscheme", ".colors", ".tdesktop-palette", ""):
            changed |= write_if_changed(out, fix(f.name, f.read_text()))
        elif not out.exists() or out.read_bytes() != f.read_bytes():
            out.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(f, out)
            changed = True
    return changed


def wallpaper_set(key: str, value: str) -> bool:
    """Write key=value into whichever aether wallpaper the desktop wears (plasmashell repaints it
    at once); desktops on other wallpapers are left alone. True if any value changed."""
    js = ("var n = 0; desktops().forEach(function (d) { if (d.wallpaperPlugin.indexOf('org.aether.') != 0) return;"
          " d.currentConfigGroup = ['Wallpaper', d.wallpaperPlugin, 'General'];"
          f" if (d.readConfig('{key}') != '{value}') {{ d.writeConfig('{key}', '{value}'); n++; }} }}); print(n);")
    out = subprocess.run(["qdbus6", "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", js],
                         capture_output=True, text=True).stdout.strip()
    return out not in ("", "0")


def main() -> int:
    hls = accent()
    colors = roles(hls) if hls else None
    changed = []

    # Kvantum: placeholders in the SVG; in the config the selection tint and links. The light theme
    # carries no cyan, so there the keys are the whole story.
    def kv_fix(name: str, text: str) -> str:
        text = recolor(text, colors)
        if colors and name.endswith(".kvconfig"):
            light = "AetherSerenity" in name
            text = set_key(text, "highlight.color", colors["accent"] + ("33" if light else "55"))
            text = set_key(text, "inactive.highlight.color", colors["accent"] + ("22" if light else "33"))
            text = set_key(text, "link.color", colors["deep"] if light else colors["accent"])
        return text
    for theme in sorted((TEMPLATES / "kvantum").glob("*")):
        if sync_tree(theme, KVANTUM / theme.name, kv_fix):
            changed.append(f"kvantum/{theme.name}")

    if (TEMPLATES / "color-schemes").is_dir() and sync_tree(TEMPLATES / "color-schemes", SCHEMES, lambda n, t: recolor(t, colors)):
        changed.append("color-schemes")
        # KDE's GTK module writes ~/.config/gtk-{3,4}.0/colors.css from the scheme only when it
        # (re)starts or the scheme's name changes: reload it so GTK apps follow the new accent - after
        # the island's own scheme apply (TileStore::applySystemAccent) has landed in kdeglobals.
        time.sleep(2)
        for verb in ("unloadModule", "loadModule"):
            subprocess.run(["qdbus6", "org.kde.kded6", "/kded", f"org.kde.kded6.{verb}", "gtkconfig"],
                           check=False, capture_output=True)

    # A scheme apply bakes the colours into kdeglobals but leaves some groups out of the accent
    # ([Colors:Header][Inactive]): fix any placeholder left there, notifying running apps.
    if colors:
        globals_path = HOME / ".config/kdeglobals"
        groups, fixed = [], 0
        for line in globals_path.read_text().splitlines():
            if line.startswith("["):
                groups = re.findall(r"\[([^\]]+)\]", line)
            elif "=" in line:
                key, value = line.split("=", 1)
                role = next((r for ph, r in PLACEHOLDERS.items() if dec(ph) == value), None)
                if role and groups:
                    args = ["kwriteconfig6", "--notify", "--file", "kdeglobals"]
                    for g in groups:
                        args += ["--group", g]
                    subprocess.run(args + ["--key", key, dec(colors[role])], check=False)
                    fixed += 1
        if fixed:
            changed.append(f"kdeglobals ({fixed} leftovers)")

    for theme in sorted((TEMPLATES / "aurorae").glob("*")):
        if sync_tree(theme, AURORAE / theme.name, lambda n, t: recolor(t, colors)):
            changed.append(f"aurorae/{theme.name}")

    # Aethergram: both recoloured palettes beside the live one, which follows the current mode.
    if (TEMPLATES / "telegram").is_dir():
        if sync_tree(TEMPLATES / "telegram", TG_LIVE.parent, lambda n, t: tg_fix(t, colors)):
            changed.append("telegram")
        src = TG_LIVE.parent / f"aether-{'light' if mode_is_light() else 'dark'}.tdesktop-palette"
        if src.exists() and replace_atomic(TG_LIVE, src.read_text()):
            changed.append(f"aethergram ({src.stem})")

    # Konsole: the cursor wears the accent.
    if KONSOLE_PROFILE.exists():
        group = ["--file", str(KONSOLE_PROFILE), "--group", "Cursor Options"]
        if colors:
            rgb = dec(colors["accent"])
            cur = subprocess.run(["kreadconfig6", *group, "--key", "CustomCursorColor"], capture_output=True, text=True).stdout.strip()
            if cur != rgb:
                subprocess.run(["kwriteconfig6", *group, "--key", "UseCustomCursorColor", "true"], check=False)
                subprocess.run(["kwriteconfig6", *group, "--key", "CustomCursorColor", rgb], check=False)
                changed.append("konsole")
        else:
            subprocess.run(["kwriteconfig6", *group, "--key", "UseCustomCursorColor", "false"], check=False)

    # Sandboxed apps (Flatpak KDE apps, GTK, Chrome) take the palette from the desktop portal, which
    # has been seen holding on to old colours after a scheme apply. If it disagrees with kdeglobals,
    # restart it so it reads them again.
    def portal_says(group: str, key: str) -> str:
        return subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.portal.Desktop",
                               "--object-path", "/org/freedesktop/portal/desktop", "--method",
                               "org.freedesktop.portal.Settings.ReadOne", f"org.kde.kdeglobals.{group}", key],
                              capture_output=True, text=True).stdout

    def local(group: str, key: str) -> str:
        return subprocess.run(["kreadconfig6", "--file", "kdeglobals", "--group", group, "--key", key],
                              capture_output=True, text=True).stdout.strip()
    stale = False
    for group, key in (("Colors:Selection", "BackgroundNormal"), ("Colors:View", "BackgroundNormal")):
        said, have = portal_says(group, key), local(group, key)
        stale |= bool(said and have and f"'{have}'" not in said)
    if stale:
        subprocess.run(["systemctl", "--user", "restart", "plasma-xdg-desktop-portal-kde.service"], check=False)
        changed.append("portal (was stale)")

    # Whichever aether wallpaper the desktop wears is drawn in the accent: hand it over, live.
    # ...and the centre shows this distribution's logo: its os-release ID, then ID_LIKE.
    osr = {}
    for line in Path("/etc/os-release").read_text().splitlines() if Path("/etc/os-release").exists() else []:
        if "=" in line:
            k, v = line.split("=", 1)
            osr[k] = v.strip().strip('"')
    distro = " ".join(filter(None, (osr.get("ID", ""), osr.get("ID_LIKE", ""))))
    if wallpaper_set("AccentColor", colors["accent"] if colors else "") | wallpaper_set("Distro", distro):
        changed.append("wallpaper")

    if any(c.startswith("aurorae") for c in changed):
        subprocess.run(["qdbus6", "org.kde.KWin", "/KWin", "reconfigure"], check=False, capture_output=True)
    print("accent", colors["accent"] if colors else "theme default", "->", ", ".join(changed) or "nothing to change")
    return 0


if __name__ == "__main__":
    sys.exit(main())
